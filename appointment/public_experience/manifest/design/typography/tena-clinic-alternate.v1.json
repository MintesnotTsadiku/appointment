      "sizeScale": "comfortable",
      "lineHeight": 1.62,
      "letterSpacing": "0"
    },
    "ui": {
      "family": "Quiet Trust UI",
      "assetKey": "quiet-trust-body",
      "weight": 600,
      "sizeScale": "compact",
      "lineHeight": 1.25,
      "letterSpacing": "0.01em"
    },
    "numeric": {
      "family": "Quiet Trust UI",
      "assetKey": "quiet-trust-body",
