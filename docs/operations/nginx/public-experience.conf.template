# Reference Nginx template for the appointment public experience.
#
# This mirrors what appointment.public_experience.edge renders from the active
# Public Site Domain desired state. Placeholders use {{ }} and must be replaced
# by the deployment tooling (or the generated file staged by the adapter).
#
# Key invariant: every verified host is routed to ONE canonical Frappe site and
# identified with a trusted X-Frappe-Site-Name header. Never create a Frappe
# site per customer, and never trust an inbound X-Frappe-Site-Name.

map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# Platform hostname (slug in the path).
server {
    listen 80;
    listen [::]:80;
    server_name {{ platform_host }};

    # certbot --nginx rewrites these to TLS listeners and adds the 80->443 redirect.
    location /.well-known/acme-challenge/ { root /var/www/certbot; }

    set $frappe_site "{{ frappe_site }}";

    location /socket.io/ {
        proxy_pass http://127.0.0.1:{{ socketio_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Frappe-Site-Name $frappe_site;
    }

    location /assets/ {
        alias {{ assets_root }}/;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location /files/ {
        proxy_set_header X-Frappe-Site-Name $frappe_site;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:{{ web_port }};
    }

    location / {
        proxy_set_header X-Frappe-Site-Name $frappe_site;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:{{ web_port }};
    }
}

# One block per Active custom domain, rendered by the adapter.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name {{ custom_domain }};

    ssl_certificate /etc/letsencrypt/live/{{ custom_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ custom_domain }}/privkey.pem;
    add_header Strict-Transport-Security "max-age=31536000" always;

    set $frappe_site "{{ frappe_site }}";

    # Public routes only on customer domains. Exact public reads must appear
    # before the management/API deny rule.
    location = /api/method/appointment.public_experience.api.get_public_ui_config {
        proxy_set_header X-Frappe-Site-Name $frappe_site;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:{{ web_port }};
    }

    location = /api/method/appointment.public_experience.api.get_public_experience_snapshot {
        proxy_set_header X-Frappe-Site-Name $frappe_site;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:{{ web_port }};
    }

    location ~ ^/(app|login|logout|api|private|desk)(/|$) { return 404; }
    location /socket.io/ { return 404; }

    location /files/ {
        proxy_set_header X-Frappe-Site-Name $frappe_site;
        proxy_set_header Host $host;
        proxy_pass http://127.0.0.1:{{ web_port }};
    }

    location / {
        proxy_set_header X-Frappe-Site-Name $frappe_site;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_pass http://127.0.0.1:{{ web_port }};
    }
}

# Default server: reject unknown hosts (never serve the default/first vhost).
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    return 444;
}
