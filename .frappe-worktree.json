{
  "version": 1,
  "app_name": "appointment",
  "site_prefix": "meet-beta",
  "dependency_apps": [
    "agent_harness",
    "agent_plane"
  ],
  "frontend": {
    "directory": "frontend",
    "command": [
      "npm",
      "run",
      "dev"
    ],
    "install_command": [
      "npm",
      "ci"
    ],
    "health_path": "/",
    "environment": {
      "VITE_ENABLE_SOCKET": "true",
      "VITE_SOCKET_PORT": "{frontend_port}",
      "VITE_SITE_PORT": "{web_port}",
      "VITE_BASE_URL": "",
      "VITE_DISABLE_STRICT_MODE": "true"
    }
  },
  "credentials": {},
  "site_config": {
    "mute_emails": 1,
    "pause_scheduler": 1
  },
  "template": {
    "enabled": false
  }
}
