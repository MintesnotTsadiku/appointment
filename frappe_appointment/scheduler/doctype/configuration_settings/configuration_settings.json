   "fieldname": "creation_order_info",
   "fieldtype": "HTML",
   "label": "Creation Order",
   "options": "<div style='background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%); border: 2px solid #00D9FF; color: #ffffff; padding: 20px; border-radius: 8px; margin-bottom: 20px;'>\n  <h3 style='margin-top: 0; color: #00D9FF;'>📋 Demo Data Generator</h3>\n  <p style='margin-bottom: 15px; color: #e0e0e0;'>Select which data types to generate. Data will be created in the correct order:</p>\n  <ol style='line-height: 1.8; margin: 0; padding-left: 20px; color: #cccccc;'>\n    <li><strong style=\"color: #00D9FF;\">Organizations</strong> - Business entities (clinics, salons)</li>\n    <li><strong style=\"color: #00D9FF;\">Providers</strong> - Individual service providers (doctors, stylists)</li>\n    <li><strong style=\"color: #00D9FF;\">Services</strong> - Appointment types offered</li>\n    <li><strong style=\"color: #00D9FF;\">Locations</strong> - Physical locations with opening hours</li>\n    <li><strong style=\"color: #00D9FF;\">Appointments</strong> - Booked appointments (last 2 weeks)</li>\n  </ol>\n  <div style='margin-top: 15px; padding: 10px; background: rgba(0, 217, 255, 0.1); border-left: 3px solid #00D9FF; border-radius: 4px;'>\n    <strong style=\"color: #00D9FF;\">💡 Tip:</strong> <span style=\"color: #e0e0e0;\">Check the boxes below and click \"Generate Demo Data\" to create realistic Ethiopian test data.</span>\n  </div>\n</div>"
